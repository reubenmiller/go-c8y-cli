{
	"name": "go-c8y-cli",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"runArgs": [ "--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined" ],

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [9000],

	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh",
				"terminal.integrated.profiles.linux": {
					"bash": {
						"path": "bash"
					},
					"zsh": {
						"path": "zsh"
					},
					"fish": {
						"path": "fish"
					},
					"tmux": {
						"path": "tmux",
						"icon": "terminal-tmux"
					},
					"pwsh": {
						"path": "pwsh",
						"icon": "terminal-powershell"
					}
				},
				"go.lintTool": "golangci-lint",
				"go.lintFlags": ["--fast"],

				// Yaml code completion
				"yaml.completion": true,
				"yaml.schemas": {
					"./api/spec/schema.json": "api/spec/yaml/*.yaml",
					"./tools/schema/session.schema.json": ".cumulocity/*.y*ml"
				},
				"powershell.pester.useLegacyCodeLens": false,
				"extensions.ignoreRecommendations": true,
				"go.testEnvFile": "${workspaceFolder}/.env",
				"go.delveConfig": {
					"dlvLoadConfig": {
						"maxStringLen": 1024,
						"maxArrayValues": 1000
					},
					"apiVersion": 2
				}
			},

			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"golang.go",
				"ms-vscode.PowerShell",
				"redhat.vscode-yaml",
				"eamodio.gitlens",
				"task.vscode-task"
			]
		}
	},

	// Bind-mount the host Docker socket so the CLI inside the container can talk to Docker.
	"mounts": [
		"source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
	],

	// Install powershell module dependencies for tests etc.
	"postCreateCommand": "task checkout-addons",

	// Comment out the next line to run as root
	"remoteUser": "vscode"
}